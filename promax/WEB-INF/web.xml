<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Hostel Management System</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- 1. Authentication Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- 2. Student Management & Profile Servlet -->
    <servlet>
        <servlet-name>StudentServlet</servlet-name>
        <servlet-class>controller.StudentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentServlet</servlet-name>
        <url-pattern>/admin/student</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StudentServlet</servlet-name>
        <url-pattern>/student/update-profile</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StudentServlet</servlet-name>
        <url-pattern>/student/student</url-pattern>
    </servlet-mapping>

    <!-- 3. Room Management Servlet -->
    <servlet>
        <servlet-name>RoomServlet</servlet-name>
        <servlet-class>controller.RoomServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RoomServlet</servlet-name>
        <url-pattern>/admin/room</url-pattern>
    </servlet-mapping>

    <!-- 4. Room Allocation Servlet -->
    <servlet>
        <servlet-name>AllocationServlet</servlet-name>
        <servlet-class>controller.AllocationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AllocationServlet</servlet-name>
        <url-pattern>/admin/allocation</url-pattern>
    </servlet-mapping>

    <!-- 5. Fee Management Servlet -->
    <servlet>
        <servlet-name>FeeServlet</servlet-name>
        <servlet-class>controller.FeeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FeeServlet</servlet-name>
        <url-pattern>/admin/fee</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>FeeServlet</servlet-name>
        <url-pattern>/fee</url-pattern>
    </servlet-mapping>

    <!-- 6. Food Price Settings Servlet -->
    <servlet>
        <servlet-name>FoodSettingsServlet</servlet-name>
        <servlet-class>controller.FoodSettingsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FoodSettingsServlet</servlet-name>
        <url-pattern>/admin/food-settings</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>FoodSettingsServlet</servlet-name>
        <url-pattern>/admin/settings</url-pattern>
    </servlet-mapping>

    <!-- 7. Admin Profile Servlet -->
    <servlet>
        <servlet-name>AdminProfileServlet</servlet-name>
        <servlet-class>controller.AdminProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminProfileServlet</servlet-name>
        <url-pattern>/admin/profile</url-pattern>
    </servlet-mapping>

    <!-- 8. Complaint Management Servlet -->
    <servlet>
        <servlet-name>ComplaintServlet</servlet-name>
        <servlet-class>controller.ComplaintServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ComplaintServlet</servlet-name>
        <url-pattern>/admin/complaint</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ComplaintServlet</servlet-name>
        <url-pattern>/complaint</url-pattern>
    </servlet-mapping>

    <!-- 9. Fee Receipt Servlet -->
    <servlet>
        <servlet-name>ReceiptServlet</servlet-name>
        <servlet-class>controller.ReceiptServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReceiptServlet</servlet-name>
        <url-pattern>/receipt</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ReceiptServlet</servlet-name>
        <url-pattern>/admin/receipt</url-pattern>
    </servlet-mapping>

    <!-- 10. Online Payment Servlet -->
    <servlet>
        <servlet-name>PaymentServlet</servlet-name>
        <servlet-class>controller.PaymentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentServlet</servlet-name>
        <url-pattern>/payment</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PaymentServlet</servlet-name>
        <url-pattern>/student/payment</url-pattern>
    </servlet-mapping>

    <!-- 11. Server-Side Razorpay Order Creation Servlet -->
    <servlet>
        <servlet-name>RazorpayOrderServlet</servlet-name>
        <servlet-class>controller.RazorpayOrderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RazorpayOrderServlet</servlet-name>
        <url-pattern>/create-razorpay-order</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RazorpayOrderServlet</servlet-name>
        <url-pattern>/student/create-order</url-pattern>
    </servlet-mapping>

    <!-- Session Configuration (30 minutes) -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
